#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
runner="$script_dir/src/pack.sh"
root_helper="$script_dir/src/root_config.py"

die() {
  printf '[ERR] %s\n' "$*" >&2
  exit 1
}

pick_config_python() {
  if command -v python3 >/dev/null 2>&1; then
    CONFIG_PY=(python3)
  elif command -v python >/dev/null 2>&1; then
    CONFIG_PY=(python)
  elif command -v py >/dev/null 2>&1; then
    CONFIG_PY=(py -3)
  else
    die "Python is required to read conf.toml."
  fi
}

load_conf_export() {
  local scope="$1"
  local cwd git_top output
  cwd="$(pwd)"
  git_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  output="$("${CONFIG_PY[@]}" "$root_helper" export --command "$scope" --cwd "$cwd" --git-top-level "$git_top" --tool-root "$script_dir")" \
    || die "Failed to read conf.toml for scope '$scope'."
  eval "$output"
}

update_table() {
  local config_file="$1" table="$2"
  shift 2
  "${CONFIG_PY[@]}" "$root_helper" update-table --config-file "$config_file" --table "$table" "$@"
}

prompt_default() {
  local prompt="$1" default_value="${2:-}" response=""
  if [[ -n "$default_value" ]]; then
    read -r -p "$prompt [$default_value]: " response
    printf '%s' "${response:-$default_value}"
  else
    read -r -p "$prompt: " response
    printf '%s' "$response"
  fi
}

prompt_bool() {
  local prompt="$1" default_value="$2" response=""
  read -r -p "$prompt [$default_value]: " response
  response="${response,,}"
  if [[ -z "$response" ]]; then
    printf '%s' "$default_value"
    return 0
  fi
  case "$response" in
    true|yes|y|1) printf '%s' "true" ;;
    false|no|n|0) printf '%s' "false" ;;
    *) die "Invalid boolean value for $prompt. Use true/false, yes/no, y/n, or 1/0." ;;
  esac
}

prompt_update() {
  local prompt="$1" response=""
  read -r -p "$prompt: " response
  if [[ -z "$response" ]]; then
    printf '%s' ""
    return 0
  fi
  if [[ "$response" == "-1" || "$response" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s' "$response"
    return 0
  fi
  die "Invalid pack.update value. Use -1, a positive integer, or leave it empty."
}

ensure_conf_exists() {
  [[ "${CFG_HAS_CONF_TOML:-0}" == "1" ]] || die "conf.toml not found at ${CFG_CONFIG_FILE:-unknown}. Run the appropriate setup command first."
}

usage() {
  cat <<'EOF'
pack - create and optionally send a sync pack

Usage:
  pack [runtime options]
  pack setup
  pack doctor
  pack [pack options] send [send options]
  pack send setup
  pack [pack options] send [send options] doctor

Configuration:
  Uses the global conf.toml in the sync_tool directory.
  Pack settings live in [pack].
  Telegram target for send lives in [pack.send.telegram].
  Shared Telegram auth/proxy lives in [telegram.common].

Commands:
  pack                 create a local archive using conf.toml
  pack setup           interactively rewrite [pack]
  pack doctor          validate [pack] and run a dry-run of pack creation
  pack send            create and send the archive via Telegram
  pack send setup      interactively rewrite [pack.send.telegram]
  pack send doctor     validate Telegram auth/proxy and target chat

Pack options:
  --output-dir PATH
  --pack-prefix PREFIX
  --machine-name NAME
  --remote NAME
  -u, --update [N]
  --branch NAME
  --branches LIST
  --with-tags 0|1
  --dry-run

Send options:
  --api-id ID
  --api-hash HASH
  --session PATH
  --to PEER
  --ack-scan-limit N
  --proxy-type none|socks5|http|mtproto
  --socks5-host HOST --socks5-port PORT [--socks5-user USER] [--socks5-password PASS]
  --http-host HOST --http-port PORT [--http-user USER] [--http-password PASS]
  --mtproto-host HOST --mtproto-port PORT --mtproto-secret SECRET

Notes:
  Canonical CLI syntax uses --key value.
  setup is terminal and accepts no runtime flags.
  doctor is terminal and validates the final effective configuration after overrides.
EOF
}

