build_pack_args() {
  PACK_ARGS=()
  [[ -n "${CFG_PACK_OUTPUT_DIR:-}" ]] && PACK_ARGS+=(--output-dir "$CFG_PACK_OUTPUT_DIR")
  [[ -n "${CFG_PACK_PACK_PREFIX:-}" ]] && PACK_ARGS+=(--pack-prefix "$CFG_PACK_PACK_PREFIX")
  [[ -n "${CFG_TELEGRAM_COMMON_LOCAL_MACHINE_NAME:-}" ]] && PACK_ARGS+=(--machine-name "$CFG_TELEGRAM_COMMON_LOCAL_MACHINE_NAME")
  [[ -n "${CFG_PACK_REMOTE_NAME:-}" ]] && PACK_ARGS+=(--remote "$CFG_PACK_REMOTE_NAME")
  if [[ -n "${CFG_PACK_UPDATE:-}" ]]; then
    PACK_ARGS+=(--update "$CFG_PACK_UPDATE")
  fi
  return 0
}

build_pack_passthrough_args() {
  PACK_PASSTHROUGH_ARGS=()
  local -a args=("$@")
  local i=0 arg next
  while [[ $i -lt ${#args[@]} ]]; do
    arg="${args[$i]}"
    next=""
    if [[ $((i + 1)) -lt ${#args[@]} ]]; then
      next="${args[$((i + 1))]}"
    fi
    case "$arg" in
      --branch|--branches|--with-tags)
        PACK_PASSTHROUGH_ARGS+=("$arg" "$next")
        i=$((i + 2))
        ;;
      --branch=*|--branches=*|--with-tags=*)
        PACK_PASSTHROUGH_ARGS+=("$arg")
        i=$((i + 1))
        ;;
      --dry-run)
        PACK_PASSTHROUGH_ARGS+=("$arg")
        i=$((i + 1))
        ;;
      *)
        i=$((i + 1))
        ;;
    esac
  done
}

append_pack_send_telegram_args() {
  local -n _args_ref="$1"
  [[ -n "${CFG_TELEGRAM_COMMON_API_ID:-}" ]] && _args_ref+=(--api-id "$CFG_TELEGRAM_COMMON_API_ID")
  [[ -n "${CFG_TELEGRAM_COMMON_API_HASH:-}" ]] && _args_ref+=(--api-hash "$CFG_TELEGRAM_COMMON_API_HASH")
  [[ -n "${CFG_TELEGRAM_COMMON_SESSION:-}" ]] && _args_ref+=(--session "$CFG_TELEGRAM_COMMON_SESSION")
  [[ -n "${CFG_PACK_SEND_TELEGRAM_TO:-}" ]] && _args_ref+=(--to "$CFG_PACK_SEND_TELEGRAM_TO")
  [[ -n "${CFG_TELEGRAM_COMMON_ACK_SCAN_LIMIT:-}" ]] && _args_ref+=(--ack-scan-limit "$CFG_TELEGRAM_COMMON_ACK_SCAN_LIMIT")
  _args_ref+=(--proxy-type "${CFG_TELEGRAM_PROXY_MODE:-none}")
  case "${CFG_TELEGRAM_PROXY_MODE:-none}" in
    socks5)
      _args_ref+=(--socks5-host "${CFG_TELEGRAM_PROXY_HOST:-}" --socks5-port "${CFG_TELEGRAM_PROXY_PORT:-}")
      [[ -n "${CFG_TELEGRAM_PROXY_USERNAME:-}" ]] && _args_ref+=(--socks5-user "$CFG_TELEGRAM_PROXY_USERNAME")
      [[ -n "${CFG_TELEGRAM_PROXY_PASSWORD:-}" ]] && _args_ref+=(--socks5-password "$CFG_TELEGRAM_PROXY_PASSWORD")
      ;;
    http)
      _args_ref+=(--http-host "${CFG_TELEGRAM_PROXY_HOST:-}" --http-port "${CFG_TELEGRAM_PROXY_PORT:-}")
      [[ -n "${CFG_TELEGRAM_PROXY_USERNAME:-}" ]] && _args_ref+=(--http-user "$CFG_TELEGRAM_PROXY_USERNAME")
      [[ -n "${CFG_TELEGRAM_PROXY_PASSWORD:-}" ]] && _args_ref+=(--http-password "$CFG_TELEGRAM_PROXY_PASSWORD")
      ;;
    mtproto)
      _args_ref+=(--mtproto-host "${CFG_TELEGRAM_PROXY_HOST:-}" --mtproto-port "${CFG_TELEGRAM_PROXY_PORT:-}" --mtproto-secret "${CFG_TELEGRAM_PROXY_SECRET:-}")
      ;;
  esac
}

validate_pack_runtime_config() {
  ensure_conf_exists
  [[ -n "${CFG_PACK_OUTPUT_DIR:-}" ]] || die "[pack].output_dir is required in conf.toml. Run: pack setup"
  [[ -n "${CFG_PACK_PACK_PREFIX:-}" ]] || die "[pack].pack_prefix is required in conf.toml. Run: pack setup"
  if [[ -n "${CFG_PACK_UPDATE:-}" ]]; then
    [[ "${CFG_PACK_UPDATE}" =~ ^-?[0-9]+$ ]] || die "[pack].update must be an integer"
    if (( CFG_PACK_UPDATE == 0 || CFG_PACK_UPDATE < -1 )); then
      die "update must be -1 or a positive integer"
    fi
  fi
}

validate_pack_send_config() {
  validate_pack_runtime_config
  [[ -n "${CFG_PACK_SEND_TELEGRAM_TO:-}" ]] || die "[pack.send.telegram].to is required in conf.toml. Run: pack send setup"
  [[ -n "${CFG_TELEGRAM_COMMON_API_ID:-}" ]] || die "[telegram.common].api_id is required in conf.toml."
  [[ -n "${CFG_TELEGRAM_COMMON_API_HASH:-}" ]] || die "[telegram.common].api_hash is required in conf.toml."
  [[ -n "${CFG_TELEGRAM_COMMON_SESSION:-}" ]] || die "[telegram.common].session is required in conf.toml."
}

apply_pack_cli_overrides() {
  local -a args=("$@")
  local i=0 arg next
  while [[ $i -lt ${#args[@]} ]]; do
    arg="${args[$i]}"
    next=""
    if [[ $((i + 1)) -lt ${#args[@]} ]]; then
      next="${args[$((i + 1))]}"
    fi
    case "$arg" in
      --output-dir) CFG_PACK_OUTPUT_DIR="$next"; i=$((i + 2));;
      --output-dir=*) CFG_PACK_OUTPUT_DIR="${arg#*=}"; i=$((i + 1));;
      --pack-prefix) CFG_PACK_PACK_PREFIX="$next"; i=$((i + 2));;
      --pack-prefix=*) CFG_PACK_PACK_PREFIX="${arg#*=}"; i=$((i + 1));;
      --machine-name) CFG_TELEGRAM_COMMON_LOCAL_MACHINE_NAME="$next"; i=$((i + 2));;
      --machine-name=*) CFG_TELEGRAM_COMMON_LOCAL_MACHINE_NAME="${arg#*=}"; i=$((i + 1));;
      --update) CFG_PACK_UPDATE="$next"; i=$((i + 2));;
      --update=*) CFG_PACK_UPDATE="${arg#*=}"; i=$((i + 1));;
      --remote) CFG_PACK_REMOTE_NAME="$next"; i=$((i + 2));;
      --remote=*) CFG_PACK_REMOTE_NAME="${arg#*=}"; i=$((i + 1));;
      *) i=$((i + 1));;
    esac
  done
}

