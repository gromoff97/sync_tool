run_pack_setup() {
  load_conf_export "pack-setup"
  local output_dir pack_prefix update_value remote_name
  output_dir="$(prompt_default "pack.output_dir (where created packs are stored)" "~/syncpacks")"
  [[ -n "$output_dir" ]] || die "pack.output_dir cannot be empty."
  pack_prefix="$(prompt_default "pack.pack_prefix (filename prefix for created archives)" "syncpack")"
  [[ -n "$pack_prefix" ]] || die "pack.pack_prefix cannot be empty."
  remote_name="$(prompt_default "pack.remote_name (git remote used by update)" "origin")"
  update_value="$(prompt_update "pack.update (leave empty to disable; -1 updates only local branches; positive integer includes recent remote branches)")"

  local -a set_args
  set_args=(--set "output_dir=$output_dir" --set "pack_prefix=$pack_prefix")
  [[ -n "$update_value" ]] && set_args+=(--set "update=$update_value")
  [[ -n "$remote_name" ]] && set_args+=(--set "remote_name=$remote_name")
  update_table "${CFG_CONFIG_FILE}" "pack" "${set_args[@]}"
  printf '[APP] Updated %s [pack]\n' "$CFG_CONFIG_FILE"
}

run_pack_send_setup() {
  load_conf_export "pack-send-setup"
  local to_value
  to_value="$(prompt_default "pack.send.telegram.to (Telegram destination chat for sent packs)")"
  [[ -n "$to_value" ]] || die "pack.send.telegram.to cannot be empty."
  update_table "${CFG_CONFIG_FILE}" "pack.send.telegram" --set "to=$to_value"
  printf '[APP] Updated %s [pack.send.telegram]\n' "$CFG_CONFIG_FILE"
}

run_pack_doctor() {
  load_conf_export "pack-doctor"
  apply_pack_cli_overrides "$@"
  validate_pack_runtime_config
  build_pack_args
  build_pack_passthrough_args "$@"
  "$runner" "${PACK_ARGS[@]}" "${PACK_PASSTHROUGH_ARGS[@]}" --dry-run
}

run_pack_send_doctor() {
  load_conf_export "pack-send-doctor"
  apply_pack_cli_overrides "$@"
  apply_pack_send_cli_overrides "$@"
  validate_pack_send_config
  build_pack_args
  build_pack_passthrough_args "$@"
  "$runner" "${PACK_ARGS[@]}" "${PACK_PASSTHROUGH_ARGS[@]}" --dry-run >/dev/null
  local tg_args=()
  append_pack_send_telegram_args tg_args
  "$runner" --telegram-doctor "${tg_args[@]}" >/dev/null
  printf '[APP] pack send doctor: Telegram connection and auth look healthy.\n'
}

run_pack() {
  load_conf_export "pack"
  apply_pack_cli_overrides "$@"
  validate_pack_runtime_config
  build_pack_args
  build_pack_passthrough_args "$@"
  "$runner" "${PACK_ARGS[@]}" "${PACK_PASSTHROUGH_ARGS[@]}"
}

run_pack_send() {
  load_conf_export "pack-send"
  apply_pack_cli_overrides "$@"
  apply_pack_send_cli_overrides "$@"
  validate_pack_send_config
  build_pack_args
  build_pack_passthrough_args "$@"
  local tg_args=()
  append_pack_send_telegram_args tg_args
  "$runner" "${PACK_ARGS[@]}" "${PACK_PASSTHROUGH_ARGS[@]}" send "${tg_args[@]}"
}

option_name() {
  local token="$1"
  if [[ "$token" == *=* ]]; then
    printf '%s' "${token%%=*}"
  else
    printf '%s' "$token"
  fi
}

update_value_candidate() {
  local token="${1:-}"
  [[ "$token" =~ ^[+-]?[0-9]+$ ]]
}

validate_cli_update_value() {
  local value="$1"
  if [[ "$value" == "-1" ]]; then
    return 0
  fi
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || die "update must be -1 or a positive integer"
}

die_doctor_trailing() {
  local next="${1:-}"
  if [[ "$next" == -* ]]; then
    die "doctor does not accept options after the 'doctor' token"
  fi
  die "doctor does not accept trailing subcommands"
}

parse_pack_update_token() {
  local token="$1" next="${2:-}"
  [[ "${PACK_UPDATE_SEEN:-0}" == "0" ]] || die "Repeated --update is not allowed"
  PACK_UPDATE_SEEN="1"
  if [[ "$token" == --update=* ]]; then
    validate_cli_update_value "${token#*=}"
    PACK_ZONE_ARGS+=(--update "${token#*=}")
    PACK_PARSE_CONSUMED=1
    return 0
  fi
  if [[ "$token" =~ ^-u.+$ && "$token" != "-u" ]]; then
    die "Short option forms -u7 and -u=7 are not supported"
  fi
  if update_value_candidate "$next"; then
    validate_cli_update_value "$next"
    PACK_ZONE_ARGS+=(--update "$next")
    PACK_PARSE_CONSUMED=2
    return 0
  fi
  PACK_ZONE_ARGS+=(--update "-1")
  PACK_PARSE_CONSUMED=1
}

consume_pack_zone_token() {
  local token="$1" next="${2:-}" name
  name="$(option_name "$token")"
  case "$token" in
    --update-remote|--update-remote=*) die "--update-remote was removed; use --update" ;;
    --recent-days|--recent-days=*) die "--recent-days was removed; use --update N" ;;
    -u|--update|--update=*) parse_pack_update_token "$token" "$next" ;;
    --output-dir|--pack-prefix|--machine-name|--remote|--branch|--branches|--with-tags)
      [[ -n "$next" ]] || die "Missing value for $token"
      PACK_ZONE_ARGS+=("$token" "$next")
      PACK_PARSE_CONSUMED=2
      ;;
    --output-dir=*|--pack-prefix=*|--machine-name=*|--remote=*|--branch=*|--branches=*|--with-tags=*)
      PACK_ZONE_ARGS+=("$token")
      PACK_PARSE_CONSUMED=1
      ;;
    --dry-run)
      PACK_ZONE_ARGS+=("$token")
      PACK_PARSE_CONSUMED=1
      ;;
    --api-id|--api-id=*|--api-hash|--api-hash=*|--session|--session=*|--to|--to=*|--ack-scan-limit|--ack-scan-limit=*|--proxy-type|--proxy-type=*|--socks5-host|--socks5-host=*|--socks5-port|--socks5-port=*|--socks5-user|--socks5-user=*|--socks5-password|--socks5-password=*|--http-host|--http-host=*|--http-port|--http-port=*|--http-user|--http-user=*|--http-password|--http-password=*|--mtproto-host|--mtproto-host=*|--mtproto-port|--mtproto-port=*|--mtproto-secret|--mtproto-secret=*)
      die "$(option_name "$token") is only valid for 'pack send'"
      ;;
    --*|-*)
      die "Unknown option: $token (use --help)"
      ;;
    *)
      die "Unknown subcommand: $token (use --help)"
      ;;
  esac
}

consume_send_zone_token() {
  local token="$1" next="${2:-}"
  case "$token" in
    --api-id|--api-hash|--session|--to|--ack-scan-limit|--proxy-type|--socks5-host|--socks5-port|--socks5-user|--socks5-password|--http-host|--http-port|--http-user|--http-password|--mtproto-host|--mtproto-port|--mtproto-secret)
      [[ -n "$next" ]] || die "Missing value for $token"
      SEND_ZONE_ARGS+=("$token" "$next")
      PACK_PARSE_CONSUMED=2
      ;;
    --api-id=*|--api-hash=*|--session=*|--to=*|--ack-scan-limit=*|--proxy-type=*|--socks5-host=*|--socks5-port=*|--socks5-user=*|--socks5-password=*|--http-host=*|--http-port=*|--http-user=*|--http-password=*|--mtproto-host=*|--mtproto-port=*|--mtproto-secret=*)
      SEND_ZONE_ARGS+=("$token")
      PACK_PARSE_CONSUMED=1
      ;;
    -u|--update|--update=*|--output-dir|--output-dir=*|--pack-prefix|--pack-prefix=*|--machine-name|--machine-name=*|--remote|--remote=*|--branch|--branch=*|--branches|--branches=*|--with-tags|--with-tags=*|--dry-run)
      die "$(option_name "$token") is only valid for 'pack'"
      ;;
    --update-remote|--update-remote=*) die "--update-remote was removed; use --update" ;;
    --recent-days|--recent-days=*) die "--recent-days was removed; use --update N" ;;
    --*|-*)
      die "Unknown option: $token (use --help)"
      ;;
    *)
      die "Unknown subcommand: $token (use --help)"
      ;;
  esac
}

parse_pack_cli() {
  PACK_ACTION="run_pack"
  PACK_ZONE_ARGS=()
  SEND_ZONE_ARGS=()
  PACK_UPDATE_SEEN="0"
  local zone="pack"

  while [[ $# -gt 0 ]]; do
    if [[ "$zone" == "pack" ]]; then
      case "$1" in
        --help|-h)
          shift
          [[ $# -eq 0 ]] || die "Unknown option: --help (use --help)"
          PACK_ACTION="show_help"
          return 0
          ;;
        push)
          die "pack push was removed; use pack send"
          ;;
        setup)
          [[ ${#PACK_ZONE_ARGS[@]} -eq 0 ]] || die "setup does not accept runtime options"
          shift
          [[ $# -eq 0 ]] || die "setup does not accept trailing subcommands"
          PACK_ACTION="run_pack_setup"
          return 0
          ;;
        doctor)
          shift
          [[ $# -eq 0 ]] || die_doctor_trailing "${1:-}"
          PACK_ACTION="run_pack_doctor"
          return 0
          ;;
        send)
          shift
          zone="send"
          continue
          ;;
        *)
          consume_pack_zone_token "$@"
          shift "$PACK_PARSE_CONSUMED"
          ;;
      esac
    else
      case "$1" in
        --help|-h)
          shift
          [[ ${#SEND_ZONE_ARGS[@]} -eq 0 && $# -eq 0 ]] || die "Unknown option: --help (use --help)"
          PACK_ACTION="show_send_help"
          return 0
          ;;
        setup)
          [[ ${#PACK_ZONE_ARGS[@]} -eq 0 && ${#SEND_ZONE_ARGS[@]} -eq 0 ]] || die "setup does not accept runtime options"
          shift
          [[ $# -eq 0 ]] || die "setup does not accept trailing subcommands"
          PACK_ACTION="run_pack_send_setup"
          return 0
          ;;
        doctor)
          shift
          [[ $# -eq 0 ]] || die_doctor_trailing "${1:-}"
          PACK_ACTION="run_pack_send_doctor"
          return 0
          ;;
        *)
          consume_send_zone_token "$@"
          shift "$PACK_PARSE_CONSUMED"
          ;;
      esac
    fi
  done

  if [[ "$zone" == "send" ]]; then
    PACK_ACTION="run_pack_send"
  fi
}

pick_config_python
parse_pack_cli "$@"

case "$PACK_ACTION" in
  show_help)
    usage
    ;;
  show_send_help)
    usage_send
    ;;
  run_pack_setup)
    run_pack_setup
    ;;
  run_pack_doctor)
    run_pack_doctor "${PACK_ZONE_ARGS[@]}"
    ;;
  run_pack_send_setup)
    run_pack_send_setup
    ;;
  run_pack_send_doctor)
    run_pack_send_doctor "${PACK_ZONE_ARGS[@]}" "${SEND_ZONE_ARGS[@]}"
    ;;
  run_pack_send)
    run_pack_send "${PACK_ZONE_ARGS[@]}" "${SEND_ZONE_ARGS[@]}"
    ;;
  run_pack)
    run_pack "${PACK_ZONE_ARGS[@]}"
    ;;
  *)
    die "Unsupported pack action: $PACK_ACTION"
    ;;
esac
