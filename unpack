run_unpack_setup() {
  load_conf_export "unpack-setup"
  local pack_dir pack_prefix project_name peer ff_only force_tags prune_remote_refs prune_local_branches clean_peer_refs
  pack_dir="$(prompt_default "unpack.pack_dir" "${CFG_UNPACK_PACK_DIR:-$HOME/syncpacks}")"
  [[ -n "$pack_dir" ]] || die "unpack.pack_dir cannot be empty."
  pack_prefix="$(prompt_default "unpack.pack_prefix" "${CFG_UNPACK_PACK_PREFIX:-syncpack}")"
  [[ -n "$pack_prefix" ]] || die "unpack.pack_prefix cannot be empty."
  project_name="$(prompt_default "unpack.project_name" "${CFG_UNPACK_PROJECT_NAME:-}")"
  peer="$(prompt_default "unpack.peer" "${CFG_UNPACK_PEER:-sync}")"
  [[ -n "$peer" ]] || die "unpack.peer cannot be empty."
  ff_only="$(prompt_bool "unpack.ff_only" "$([[ "${CFG_UNPACK_FF_ONLY:-1}" == "1" ]] && printf true || printf false)")"
  force_tags="$(prompt_bool "unpack.force_tags" "$([[ "${CFG_UNPACK_FORCE_TAGS:-0}" == "1" ]] && printf true || printf false)")"
  prune_remote_refs="$(prompt_bool "unpack.prune_remote_refs" "$([[ "${CFG_UNPACK_PRUNE_REMOTE_REFS:-1}" == "1" ]] && printf true || printf false)")"
  prune_local_branches="$(prompt_bool "unpack.prune_local_branches" "$([[ "${CFG_UNPACK_PRUNE_LOCAL_BRANCHES:-0}" == "1" ]] && printf true || printf false)")"
  clean_peer_refs="$(prompt_bool "unpack.clean_peer_refs" "$([[ "${CFG_UNPACK_CLEAN_PEER_REFS:-1}" == "1" ]] && printf true || printf false)")"

  local -a set_args
  set_args=(
    --set "pack_dir=$pack_dir"
    --set "pack_prefix=$pack_prefix"
    --set "project_name=$project_name"
    --set "peer=$peer"
    --set "ff_only=$ff_only"
    --set "force_tags=$force_tags"
    --set "prune_remote_refs=$prune_remote_refs"
    --set "prune_local_branches=$prune_local_branches"
    --set "clean_peer_refs=$clean_peer_refs"
  )
  update_table "${CFG_CONFIG_FILE}" "unpack" "${set_args[@]}"
  printf '[APP] Updated %s [unpack]\n' "$CFG_CONFIG_FILE"
}

run_unpack_take_setup() {
  load_conf_export "unpack-take-setup"
  local from_value
  from_value="$(prompt_default "unpack.take.telegram.from" "${CFG_UNPACK_TAKE_TELEGRAM_FROM:-}")"
  [[ -n "$from_value" ]] || die "unpack.take.telegram.from cannot be empty."
  update_table "${CFG_CONFIG_FILE}" "unpack.take.telegram" --set "from=$from_value"
  printf '[APP] Updated %s [unpack.take.telegram]\n' "$CFG_CONFIG_FILE"
}

run_unpack_doctor() {
  load_conf_export "unpack-doctor"
  apply_unpack_cli_overrides "$@"
  validate_unpack_runtime_config
  build_unpack_args
  build_unpack_passthrough_args "$@"
  "$runner" "${UNPACK_ARGS[@]}" "${UNPACK_PASSTHROUGH_ARGS[@]}" --dry-run >/dev/null
  printf '[APP] unpack doctor: base configuration looks valid.\n'
}

run_unpack_take_doctor() {
  load_conf_export "unpack-take-doctor"
  apply_unpack_cli_overrides "$@"
  apply_unpack_take_cli_overrides "$@"
  validate_unpack_take_config
  build_unpack_args
  build_unpack_passthrough_args "$@"
  "$runner" "${UNPACK_ARGS[@]}" "${UNPACK_PASSTHROUGH_ARGS[@]}" --dry-run >/dev/null
  local tg_args=()
  append_unpack_take_telegram_args tg_args
  "$runner" --telegram-doctor "${tg_args[@]}" >/dev/null
  printf '[APP] unpack take doctor: configuration and Telegram prerequisites look healthy.\n'
}

run_unpack() {
  load_conf_export "unpack"
  apply_unpack_cli_overrides "$@"
  validate_unpack_runtime_config
  build_unpack_args
  build_unpack_passthrough_args "$@"
  "$runner" "${UNPACK_ARGS[@]}" "${UNPACK_PASSTHROUGH_ARGS[@]}"
}

run_unpack_take() {
  load_conf_export "unpack-take"
  apply_unpack_cli_overrides "$@"
  apply_unpack_take_cli_overrides "$@"
  validate_unpack_take_config
  build_unpack_args
  build_unpack_passthrough_args "$@"
  local tg_args=()
  append_unpack_take_telegram_args tg_args
  "$runner" "${UNPACK_ARGS[@]}" "${UNPACK_PASSTHROUGH_ARGS[@]}" take "${tg_args[@]}"
}

option_name() {
  local token="$1"
  if [[ "$token" == *=* ]]; then
    printf '%s' "${token%%=*}"
  else
    printf '%s' "$token"
  fi
}

die_doctor_trailing() {
  local next="${1:-}"
  if [[ "$next" == -* ]]; then
    die "doctor does not accept options after the 'doctor' token"
  fi
  die "doctor does not accept trailing subcommands"
}

consume_unpack_zone_token() {
  local token="$1" next="${2:-}"
  case "$token" in
    --pack-dir|--pack-prefix|--project-name|--peer|--ff-only|--force-tags|--prune-remote-refs|--prune-local-branches|--clean-peer-refs|--pack-file)
      [[ -n "$next" ]] || die "Missing value for $token"
      UNPACK_ZONE_ARGS+=("$token" "$next")
      UNPACK_PARSE_CONSUMED=2
      ;;
    --pack-dir=*|--pack-prefix=*|--project-name=*|--peer=*|--ff-only=*|--force-tags=*|--prune-remote-refs=*|--prune-local-branches=*|--clean-peer-refs=*|--pack-file=*)
      UNPACK_ZONE_ARGS+=("$token")
      UNPACK_PARSE_CONSUMED=1
      ;;
    --dry-run)
      UNPACK_ZONE_ARGS+=("$token")
      UNPACK_PARSE_CONSUMED=1
      ;;
    --api-id|--api-id=*|--api-hash|--api-hash=*|--session|--session=*|--session-string|--session-string=*|--from|--from=*|--python-min|--python-min=*|--proxy-type|--proxy-type=*|--socks5-host|--socks5-host=*|--socks5-port|--socks5-port=*|--socks5-user|--socks5-user=*|--socks5-password|--socks5-password=*|--http-host|--http-host=*|--http-port|--http-port=*|--http-user|--http-user=*|--http-password|--http-password=*|--mtproto-host|--mtproto-host=*|--mtproto-port|--mtproto-port=*|--mtproto-secret|--mtproto-secret=*)
      die "$(option_name "$token") is only valid for 'unpack take'"
      ;;
    --*|-*)
      die "Unknown option: $token (use --help)"
      ;;
    *)
      die "Unknown subcommand: $token (use --help)"
      ;;
  esac
}

consume_take_zone_token() {
  local token="$1" next="${2:-}"
  case "$token" in
    --api-id|--api-hash|--session|--session-string|--from|--python-min|--proxy-type|--socks5-host|--socks5-port|--socks5-user|--socks5-password|--http-host|--http-port|--http-user|--http-password|--mtproto-host|--mtproto-port|--mtproto-secret)
      [[ -n "$next" ]] || die "Missing value for $token"
      TAKE_ZONE_ARGS+=("$token" "$next")
      UNPACK_PARSE_CONSUMED=2
      ;;
    --api-id=*|--api-hash=*|--session=*|--session-string=*|--from=*|--python-min=*|--proxy-type=*|--socks5-host=*|--socks5-port=*|--socks5-user=*|--socks5-password=*|--http-host=*|--http-port=*|--http-user=*|--http-password=*|--mtproto-host=*|--mtproto-port=*|--mtproto-secret=*)
      TAKE_ZONE_ARGS+=("$token")
      UNPACK_PARSE_CONSUMED=1
      ;;
    --pack-dir|--pack-dir=*|--pack-prefix|--pack-prefix=*|--project-name|--project-name=*|--peer|--peer=*|--ff-only|--ff-only=*|--force-tags|--force-tags=*|--prune-remote-refs|--prune-remote-refs=*|--prune-local-branches|--prune-local-branches=*|--clean-peer-refs|--clean-peer-refs=*|--pack-file|--pack-file=*|--dry-run)
      die "$(option_name "$token") is only valid for 'unpack'"
      ;;
    --*|-*)
      die "Unknown option: $token (use --help)"
      ;;
    *)
      die "Unknown subcommand: $token (use --help)"
      ;;
  esac
}

parse_unpack_cli() {
  UNPACK_ACTION="run_unpack"
  UNPACK_ZONE_ARGS=()
  TAKE_ZONE_ARGS=()
  local zone="unpack"

  while [[ $# -gt 0 ]]; do
    if [[ "$zone" == "unpack" ]]; then
      case "$1" in
        --help|-h)
          shift
          [[ $# -eq 0 ]] || die "Unknown option: --help (use --help)"
          UNPACK_ACTION="show_help"
          return 0
          ;;
        pull)
          die "unpack pull was removed; use unpack take"
          ;;
        setup)
          [[ ${#UNPACK_ZONE_ARGS[@]} -eq 0 ]] || die "setup does not accept runtime options"
          shift
          [[ $# -eq 0 ]] || die "setup does not accept trailing subcommands"
          UNPACK_ACTION="run_unpack_setup"
          return 0
          ;;
        doctor)
          shift
          [[ $# -eq 0 ]] || die_doctor_trailing "${1:-}"
          UNPACK_ACTION="run_unpack_doctor"
          return 0
          ;;
        take)
          shift
          zone="take"
          continue
          ;;
        *)
          consume_unpack_zone_token "$@"
          shift "$UNPACK_PARSE_CONSUMED"
          ;;
      esac
    else
      case "$1" in
        --help|-h)
          shift
          [[ ${#TAKE_ZONE_ARGS[@]} -eq 0 && $# -eq 0 ]] || die "Unknown option: --help (use --help)"
          UNPACK_ACTION="show_take_help"
          return 0
          ;;
        setup)
          [[ ${#UNPACK_ZONE_ARGS[@]} -eq 0 && ${#TAKE_ZONE_ARGS[@]} -eq 0 ]] || die "setup does not accept runtime options"
          shift
          [[ $# -eq 0 ]] || die "setup does not accept trailing subcommands"
          UNPACK_ACTION="run_unpack_take_setup"
          return 0
          ;;
        doctor)
          shift
          [[ $# -eq 0 ]] || die_doctor_trailing "${1:-}"
          UNPACK_ACTION="run_unpack_take_doctor"
          return 0
          ;;
        *)
          consume_take_zone_token "$@"
          shift "$UNPACK_PARSE_CONSUMED"
          ;;
      esac
    fi
  done

  if [[ "$zone" == "take" ]]; then
    UNPACK_ACTION="run_unpack_take"
  fi
}

pick_config_python
parse_unpack_cli "$@"

case "$UNPACK_ACTION" in
  show_help)
    usage
    ;;
  show_take_help)
    usage_take
    ;;
  run_unpack_setup)
    run_unpack_setup
    ;;
  run_unpack_doctor)
    run_unpack_doctor "${UNPACK_ZONE_ARGS[@]}"
    ;;
  run_unpack_take_setup)
    run_unpack_take_setup
    ;;
  run_unpack_take_doctor)
    run_unpack_take_doctor "${UNPACK_ZONE_ARGS[@]}" "${TAKE_ZONE_ARGS[@]}"
    ;;
  run_unpack_take)
    run_unpack_take "${UNPACK_ZONE_ARGS[@]}" "${TAKE_ZONE_ARGS[@]}"
    ;;
  run_unpack)
    run_unpack "${UNPACK_ZONE_ARGS[@]}"
    ;;
  *)
    die "Unsupported unpack action: $UNPACK_ACTION"
    ;;
esac
