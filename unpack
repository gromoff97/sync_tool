#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
runner="$script_dir/src/unpack.sh"
root_helper="$script_dir/src/root_config.py"

die() {
  printf '[ERR] %s\n' "$*" >&2
  exit 1
}

pick_config_python() {
  if command -v python3 >/dev/null 2>&1; then
    CONFIG_PY=(python3)
  elif command -v python >/dev/null 2>&1; then
    CONFIG_PY=(python)
  elif command -v py >/dev/null 2>&1; then
    CONFIG_PY=(py -3)
  else
    die "Python is required to read conf.toml."
  fi
}

load_conf_export() {
  local scope="$1"
  local cwd git_top output
  cwd="$(pwd)"
  git_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  output="$("${CONFIG_PY[@]}" "$root_helper" export --command "$scope" --cwd "$cwd" --git-top-level "$git_top")" \
    || die "Failed to read conf.toml for scope '$scope'."
  eval "$output"
}

update_table() {
  local config_file="$1" table="$2"
  shift 2
  "${CONFIG_PY[@]}" "$root_helper" update-table --config-file "$config_file" --table "$table" "$@"
}

prompt_default() {
  local label="$1" default_value="${2:-}" response=""
  if [[ -n "$default_value" ]]; then
    read -r -p "$label [$default_value]: " response
    printf '%s' "${response:-$default_value}"
  else
    read -r -p "$label: " response
    printf '%s' "$response"
  fi
}

prompt_bool() {
  local label="$1" default_value="${2:-false}" response=""
  local hint="y/N"
  if [[ "$default_value" == "true" ]]; then
    hint="Y/n"
  fi
  read -r -p "$label [$hint]: " response
  response="${response,,}"
  if [[ -z "$response" ]]; then
    printf '%s' "$default_value"
    return 0
  fi
  case "$response" in
    y|yes|true|1) printf '%s' "true" ;;
    n|no|false|0) printf '%s' "false" ;;
    *) die "Expected yes/no response for '$label'." ;;
  esac
}

ensure_conf_exists() {
  [[ "${CFG_HAS_CONF_TOML:-0}" == "1" ]] || die "conf.toml not found at ${CFG_CONFIG_FILE:-unknown}. Run the appropriate setup command first."
}

usage() {
  cat <<'EOF'
unpack - apply a sync pack locally or take one from Telegram

Usage:
  unpack [runtime options]
  unpack setup
  unpack doctor
  unpack [unpack options] take [take options]
  unpack take setup
  unpack [unpack options] take [take options] doctor

Configuration:
  Uses root conf.toml.
  Unpack settings live in [unpack].
  Telegram source for take lives in [unpack.take.telegram].
  Shared Telegram auth/proxy lives in [telegram.common].

Commands:
  unpack               apply a local pack using conf.toml
  unpack setup         interactively rewrite [unpack]
  unpack doctor        validate the base unpack configuration
  unpack take          download the latest pack from Telegram and apply it
  unpack take setup    interactively rewrite [unpack.take.telegram]
  unpack take doctor   validate Telegram auth/proxy and source chat

Unpack options:
  --pack-dir PATH
  --pack-file PATH
  --pack-prefix PREFIX
  --project-name NAME
  --peer NAME
  --ff-only 0|1
  --force-tags 0|1
  --prune-remote-refs 0|1
  --prune-local-branches 0|1
  --clean-peer-refs 0|1
  --dry-run

Take options:
  --api-id ID
  --api-hash HASH
  --session PATH
  --session-string STRING
  --from PEER
  --python-min VERSION
  --proxy-type none|socks5|http|mtproto

Notes:
  Canonical CLI syntax uses --key value.
  setup is terminal and accepts no runtime flags.
  doctor is terminal and validates the final effective configuration after overrides.
EOF
}

usage_take() {
  cat <<'EOF'
unpack take - download the latest pack from Telegram and apply it

Usage:
  unpack [unpack options] take [take options]
  unpack take setup
  unpack [unpack options] take [take options] doctor

Configuration:
  Uses root conf.toml.
  Unpack settings live in [unpack].
  Telegram source for take lives in [unpack.take.telegram].
  Shared Telegram auth/proxy lives in [telegram.common].

Unpack options:
  --pack-dir PATH
  --pack-file PATH
  --pack-prefix PREFIX
  --project-name NAME
  --peer NAME
  --ff-only 0|1
  --force-tags 0|1
  --prune-remote-refs 0|1
  --prune-local-branches 0|1
  --clean-peer-refs 0|1
  --dry-run

Take options:
  --api-id ID
  --api-hash HASH
  --session PATH
  --session-string STRING
  --from PEER
  --python-min VERSION
  --proxy-type none|socks5|http|mtproto
  --socks5-host HOST --socks5-port PORT [--socks5-user USER] [--socks5-password PASS]
  --http-host HOST --http-port PORT [--http-user USER] [--http-password PASS]
  --mtproto-host HOST --mtproto-port PORT --mtproto-secret SECRET
EOF
}

build_unpack_args() {
  UNPACK_ARGS=()
  [[ -n "${CFG_UNPACK_PACK_DIR:-}" ]] && UNPACK_ARGS+=(--pack-dir "$CFG_UNPACK_PACK_DIR")
  [[ -n "${CFG_UNPACK_PACK_PREFIX:-}" ]] && UNPACK_ARGS+=(--pack-prefix "$CFG_UNPACK_PACK_PREFIX")
  [[ -n "${CFG_UNPACK_PROJECT_NAME:-}" ]] && UNPACK_ARGS+=(--project-name "$CFG_UNPACK_PROJECT_NAME")
  [[ -n "${CFG_UNPACK_PEER:-}" ]] && UNPACK_ARGS+=(--peer "$CFG_UNPACK_PEER")
  [[ -n "${CFG_UNPACK_FF_ONLY:-}" ]] && UNPACK_ARGS+=(--ff-only "$CFG_UNPACK_FF_ONLY")
  [[ -n "${CFG_UNPACK_FORCE_TAGS:-}" ]] && UNPACK_ARGS+=(--force-tags "$CFG_UNPACK_FORCE_TAGS")
  [[ -n "${CFG_UNPACK_PRUNE_REMOTE_REFS:-}" ]] && UNPACK_ARGS+=(--prune-remote-refs "$CFG_UNPACK_PRUNE_REMOTE_REFS")
  [[ -n "${CFG_UNPACK_PRUNE_LOCAL_BRANCHES:-}" ]] && UNPACK_ARGS+=(--prune-local-branches "$CFG_UNPACK_PRUNE_LOCAL_BRANCHES")
  [[ -n "${CFG_UNPACK_CLEAN_PEER_REFS:-}" ]] && UNPACK_ARGS+=(--clean-peer-refs "$CFG_UNPACK_CLEAN_PEER_REFS")
  return 0
}

build_unpack_passthrough_args() {
  UNPACK_PASSTHROUGH_ARGS=()
  local -a args=("$@")
  local i=0 arg next
  while [[ $i -lt ${#args[@]} ]]; do
    arg="${args[$i]}"
    next=""
    if [[ $((i + 1)) -lt ${#args[@]} ]]; then
      next="${args[$((i + 1))]}"
    fi
    case "$arg" in
      --pack-file)
        UNPACK_PASSTHROUGH_ARGS+=("$arg" "$next")
        i=$((i + 2))
        ;;
      --pack-file=*)
        UNPACK_PASSTHROUGH_ARGS+=("$arg")
        i=$((i + 1))
        ;;
      --dry-run)
        UNPACK_PASSTHROUGH_ARGS+=("$arg")
        i=$((i + 1))
        ;;
      *)
        i=$((i + 1))
        ;;
    esac
  done
}

append_unpack_take_telegram_args() {
  local -n _args_ref="$1"
  [[ -n "${CFG_TELEGRAM_COMMON_API_ID:-}" ]] && _args_ref+=(--api-id "$CFG_TELEGRAM_COMMON_API_ID")
  [[ -n "${CFG_TELEGRAM_COMMON_API_HASH:-}" ]] && _args_ref+=(--api-hash "$CFG_TELEGRAM_COMMON_API_HASH")
  [[ -n "${CFG_TELEGRAM_COMMON_SESSION:-}" ]] && _args_ref+=(--session "$CFG_TELEGRAM_COMMON_SESSION")
  [[ -n "${CFG_TELEGRAM_COMMON_SESSION_STRING:-}" ]] && _args_ref+=(--session-string "$CFG_TELEGRAM_COMMON_SESSION_STRING")
  [[ -n "${CFG_UNPACK_TAKE_TELEGRAM_FROM:-}" ]] && _args_ref+=(--from "$CFG_UNPACK_TAKE_TELEGRAM_FROM")
  [[ -n "${CFG_TELEGRAM_COMMON_PYTHON_MIN:-}" ]] && _args_ref+=(--python-min "$CFG_TELEGRAM_COMMON_PYTHON_MIN")
  _args_ref+=(--proxy-type "${CFG_TELEGRAM_PROXY_MODE:-none}")
  case "${CFG_TELEGRAM_PROXY_MODE:-none}" in
    socks5)
      _args_ref+=(--socks5-host "${CFG_TELEGRAM_PROXY_HOST:-}" --socks5-port "${CFG_TELEGRAM_PROXY_PORT:-}")
      [[ -n "${CFG_TELEGRAM_PROXY_USERNAME:-}" ]] && _args_ref+=(--socks5-user "$CFG_TELEGRAM_PROXY_USERNAME")
      [[ -n "${CFG_TELEGRAM_PROXY_PASSWORD:-}" ]] && _args_ref+=(--socks5-password "$CFG_TELEGRAM_PROXY_PASSWORD")
      ;;
    http)
      _args_ref+=(--http-host "${CFG_TELEGRAM_PROXY_HOST:-}" --http-port "${CFG_TELEGRAM_PROXY_PORT:-}")
      [[ -n "${CFG_TELEGRAM_PROXY_USERNAME:-}" ]] && _args_ref+=(--http-user "$CFG_TELEGRAM_PROXY_USERNAME")
      [[ -n "${CFG_TELEGRAM_PROXY_PASSWORD:-}" ]] && _args_ref+=(--http-password "$CFG_TELEGRAM_PROXY_PASSWORD")
      ;;
    mtproto)
      _args_ref+=(--mtproto-host "${CFG_TELEGRAM_PROXY_HOST:-}" --mtproto-port "${CFG_TELEGRAM_PROXY_PORT:-}" --mtproto-secret "${CFG_TELEGRAM_PROXY_SECRET:-}")
      ;;
  esac
}

validate_unpack_runtime_config() {
  ensure_conf_exists
  [[ -n "${CFG_UNPACK_PACK_DIR:-}" ]] || die "[unpack].pack_dir is required in conf.toml. Run: unpack setup"
  [[ -n "${CFG_UNPACK_PACK_PREFIX:-}" ]] || die "[unpack].pack_prefix is required in conf.toml. Run: unpack setup"
  [[ -n "${CFG_UNPACK_PEER:-}" ]] || die "[unpack].peer is required in conf.toml. Run: unpack setup"
}

validate_unpack_take_config() {
  validate_unpack_runtime_config
  [[ -n "${CFG_UNPACK_TAKE_TELEGRAM_FROM:-}" ]] || die "[unpack.take.telegram].from is required in conf.toml. Run: unpack take setup"
  [[ -n "${CFG_TELEGRAM_COMMON_API_ID:-}" ]] || die "[telegram.common].api_id is required in conf.toml."
  [[ -n "${CFG_TELEGRAM_COMMON_API_HASH:-}" ]] || die "[telegram.common].api_hash is required in conf.toml."
  if [[ -z "${CFG_TELEGRAM_COMMON_SESSION:-}" && -z "${CFG_TELEGRAM_COMMON_SESSION_STRING:-}" ]]; then
    die "Either [telegram.common].session or [telegram.common].session_string is required in conf.toml."
  fi
}

apply_unpack_cli_overrides() {
  local -a args=("$@")
  local i=0 arg next
  while [[ $i -lt ${#args[@]} ]]; do
    arg="${args[$i]}"
    next=""
    if [[ $((i + 1)) -lt ${#args[@]} ]]; then
      next="${args[$((i + 1))]}"
    fi
    case "$arg" in
      --pack-dir) CFG_UNPACK_PACK_DIR="$next"; i=$((i + 2));;
      --pack-dir=*) CFG_UNPACK_PACK_DIR="${arg#*=}"; i=$((i + 1));;
      --pack-prefix) CFG_UNPACK_PACK_PREFIX="$next"; i=$((i + 2));;
      --pack-prefix=*) CFG_UNPACK_PACK_PREFIX="${arg#*=}"; i=$((i + 1));;
      --project-name) CFG_UNPACK_PROJECT_NAME="$next"; i=$((i + 2));;
      --project-name=*) CFG_UNPACK_PROJECT_NAME="${arg#*=}"; i=$((i + 1));;
      --peer) CFG_UNPACK_PEER="$next"; i=$((i + 2));;
      --peer=*) CFG_UNPACK_PEER="${arg#*=}"; i=$((i + 1));;
      *) i=$((i + 1));;
    esac
  done
}

